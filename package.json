{
  "name": "moonie",
  "version": "0.1.0",
  "private": true,
  "description": "Moonie: a cozy watch party and hangout site (ephemeral rooms, WebRTC, no accounts, no database).",
  "scripts": {
    "setup": "npm install && npm --prefix signaling-server install",
    "dev": "next dev -p 3000",
    "dev:all": "concurrently -k -n web,signal \"next dev -p 3000\" \"npm --prefix signaling-server run dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "npm --prefix signaling-server test"
  },
  "dependencies": {
    "lucide-react": "1.77.0",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^26.0.0",
    "postcss": "8.5.33",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@4.68.8"
  }
}
