# Port to listen on (hosting platforms inject PORT)
PORT=8787
# Comma-separated allowed browser origins (required, fail closed). Exact origins only,
# e.g. https://your-app.vercel.app . Wildcard subdomains (https://*.vercel.app) admit every site on that domain.
ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOW_NO_ORIGIN=false
MAX_ROOMS=300
ROOM_MAX_PARTICIPANTS=8
MAX_CONNECTIONS_PER_IP=20
# Number of trusted proxies in front of this server (0 for local dev, 1 on Render/Railway/Fly)
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
RECONNECT_GRACE_MS=30000
HOST_GRACE_MS=10000
EMPTY_ROOM_TTL_MS=60000
MAX_ROOM_AGE_MS=43200000
SWEEP_INTERVAL_MS=1000
TURN_SKIP_MS=15000
# No-message limit for sockets not in a room, and cap on how long such a socket may stay open
IDLE_MS=30000
UNJOINED_MAX_MS=600000
# Dev only (npm run dev): port for the local signaling server. A global PORT is ignored by the dev script. Default 8787.
# SIGNALING_PORT=8787
